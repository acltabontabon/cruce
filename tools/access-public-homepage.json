			{ "type": "public", "uri": "cruce.acltabontabon.com/bridge" },
			{ "type": "public", "uri": "cruce.acltabontabon.com/bridge/*" },
			{ "type": "public", "uri": "cruce.acltabontabon.com/invite" },
			{ "type": "public", "uri": "cruce.acltabontabon.com/invite/*" }
		]
