{
	"name": "com.acltabontabon.cruce",
	"version": "0.1.0-alpha.2",
	"private": true,
	"description": "Cruce — Git-native collaboration for developers and agents.",
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"dev": "cf dev",
		"build": "cf build",
		"deploy": "pnpm setup:check && cf deploy --mode production",
		"deploy:test": "node --env-file=.env.test tools/installation-config.mjs && node --env-file=.env.test node_modules/cf/bin/cf deploy --mode production",
		"typecheck": "cf workers types && tsc -p tsconfig.worker.json && tsc -p tsconfig.ui.json && tsc -p tsconfig.test.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"format": "biome format --write .",
		"demo:repo:test": "node --test demo/auth-service/test/",
		"check": "pnpm typecheck && pnpm lint && pnpm test",
		"release:check": "node tools/check-release.mjs",
		"test:browser": "node --test test/browser/console.browser.mjs",
		"verify:cloud": "tsx tools/verify-cloud.ts",
		"verify:scenario": "tsx tools/verify-scenario.ts && bash demo/scripts/verify-scenario.sh",
		"dev:fixture": "node test/browser/server.mjs",
		"setup:check": "node tools/installation-config.mjs"
	},
	"dependencies": {
		"@cloudflare/workers-oauth-provider": "^1.2.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@modelcontextprotocol/client": "^2.3.0",
		"@modelcontextprotocol/server": "^2.3.0",
		"agents": "^0.26.0",
		"diff": "^9.0.0",
		"isomorphic-git": "1.42.6",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@cloudflare/vite-plugin": "beta",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"cf": "^1.0.0-beta.12",
		"playwright": "1.62.1",
		"tsx": "4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.3"
	},
	"engines": {
		"node": ">=22.18"
	}
}
