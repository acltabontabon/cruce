# Copy to .env.test for your explicitly authorized installation/test environment.
# No personal account or hostname is committed in deployment configuration.
CLOUDFLARE_ACCOUNT_ID=YOUR_32_CHARACTER_ACCOUNT_ID
CRUCE_PUBLIC_ORIGIN=https://cruce.example.com
CRUCE_WORKER_NAME=cruce
# Choose once; changing this after storing source is not a migration.
CRUCE_ARTIFACTS_NAMESPACE=cruce
CRUCE_ACCESS_ISSUER=https://YOUR_TEAM.cloudflareaccess.com
CRUCE_ACCESS_AUD=YOUR_APPLICATION_AUDIENCE
# Authorize cf locally, or set CLOUDFLARE_API_TOKEN privately in CI.
# For a fresh Worker configure CRUCE_SECRET using cf deploy --secrets-file.
# Preserve an existing Worker secret. Never connect provider tokens in the console.
