# Copy to .env.test for the single live MVP test environment.
# These Access identifiers are configuration, not credentials.
CRUCE_PUBLIC_ORIGIN=https://cruce.acltabontabon.workers.dev
CRUCE_ACCESS_ISSUER=https://YOUR_TEAM.cloudflareaccess.com
CRUCE_ACCESS_AUD=YOUR_APPLICATION_AUDIENCE
# Keep CRUCE_SECRET on the Worker. For a fresh Worker use cf deploy --secrets-file.
# Namespace Cloudflare credentials are connected by its owner in the console.
