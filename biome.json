{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": ["**", "!**/node_modules", "!**/.cloudflare", "!**/dist", "!**/.wrangler", "!LICENSE", "!**/*.md", "!demo"]
	},
	"formatter": {
		"indentStyle": "tab",
		"lineWidth": 140
	},
	"linter": {
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "off",
				"noDescendingSpecificity": "off"
			},
			"suspicious": {
				"noControlCharactersInRegex": "off"
			},
			"complexity": {
				"noImportantStyles": "off"
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
